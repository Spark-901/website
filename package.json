{
  "name": "spark-901-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "prettier": "^3.8.3"
  }
}
