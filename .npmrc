fetch-timeout=60000

# @west-tennessee-consulting/funnel-components (shared "stay up to date" email
# capture component) is published to GitHub Packages under the
# West-Tennessee-Consulting org, not npmjs.org. Requires NODE_AUTH_TOKEN
# (a token with read:packages, scoped to that org's restricted registry) set
# wherever `npm install` runs — see wtc-shared-packages' own README.
@west-tennessee-consulting:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
