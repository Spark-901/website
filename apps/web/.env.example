# Site
# Production: https://spark901.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe ─────────────────────────────────────────────────────────────
# Local / sandbox: use sk_test_... from Dashboard → Developers → API keys (Test mode)
# Production (Vercel): use sk_live_... — set only on Production target
STRIPE_SECRET_KEY=

# From `npm run stripe:listen` (local) or Dashboard webhook endpoint (prod)
STRIPE_WEBHOOK_SECRET=

# Optional: require ToS checkbox (needs Terms URL in Stripe Public details)
STRIPE_CHECKOUT_REQUIRE_TOS=false

# Provision sandbox Products + write TEST_PRODUCTS into lib/stripe-catalog.ts:
#   STRIPE_SECRET_KEY=sk_test_... npm run stripe:setup-sandbox
# Or after CLI auth to Spark901:
#   stripe login -p spark901
#   npm run stripe:setup-sandbox -- --from-cli

# Optional product ID overrides (set on Vercel per environment)
# STRIPE_PRODUCT_VOLUNTEER_SCHEDULER=
# STRIPE_PRODUCT_GRANT_TRACKER=
# STRIPE_PRODUCT_IMPACT_DASHBOARD=
# STRIPE_PRODUCT_COMMUNITY_HUB=
# STRIPE_PRODUCT_GENERAL_FUND=

NEXT_PUBLIC_ENABLE_ADOPTION_TRACKER=true
NEXT_PUBLIC_ENABLE_ALIVENESS_SIGNALS=true
GITHUB_TOKEN=

# Slack Workflow trigger is hardcoded in lib/slack-notify.ts (default).
# Optional override only if the trigger URL ever changes:
# SLACK_OPS_WEBHOOK_URL=

# Gift a Tool Feature Flag
NEXT_PUBLIC_ENABLE_GIFT_A_TOOL=false

# Collierville Civic Archive Feature Flag (BMA meeting summaries + PDFs)
NEXT_PUBLIC_ENABLE_CIVIC_ARCHIVE=false

# Nonprofit Feedback Loop Feature Flag (suggest a tool + beta signup)
NEXT_PUBLIC_ENABLE_NONPROFIT_FEEDBACK_LOOP=false

# ─── Ops event ledger (DynamoDB) ────────────────────────────────────────
# The durable record of every inbound site event. Slack is the notification;
# this table is the record — a Slack failure must never lose a submission.
# Bootstrap runbook (table + IAM user + policy): infra/aws/README.md
#
# Table name. UNSET = the ledger silently no-ops and nothing is persisted.
SPARK901_OPS_TABLE=
# Region for the ledger. Falls back to AWS_REGION, then us-east-1.
SPARK901_AWS_REGION=us-east-1
# Credentials for the site's dedicated least-privilege IAM user.
# SPARK901_-prefixed names are primary so they can never collide with the
# AWS_* variables the Vercel/Lambda runtime sets for itself. Never commit
# these — set them straight into Vercel env vars (encrypted).
SPARK901_AWS_ACCESS_KEY_ID=
SPARK901_AWS_SECRET_ACCESS_KEY=
# Salt for the SHA-256 hash of the client IP (`openssl rand -hex 32`).
# ABSENT = no IP is stored at all — an unsalted IPv4 hash is brute-forceable
# in seconds, so it would not actually be anonymised.
SPARK901_IP_HASH_SALT=

# ─── Cloudflare Turnstile ───────────────────────────────────────────────
# Public site key (safe for client). Production widget for spark901.com:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD5zNfjmGv1zSkxE
# Server-only secret — set on Vercel as SPARK901_TURNSTILE_SECRET_KEY
# SPARK901_TURNSTILE_SECRET_KEY=

# ─── Ask the Archive Feature Flag (civic-archive Q&A demo + donate CTA) ──
NEXT_PUBLIC_ENABLE_ASK_THE_ARCHIVE=false

# ─── rag-gateway (WTC-internal Cloudflare Worker) ───────────────────────
# Powers "Ask the Archive" retrieval and the Job 2 sync automation's
# transcript ingest. See lib/rag-gateway-client.ts for why this repo can't
# use the official (unpublished, workspace-only) client package.
#
# Base URL of the deployed rag-gateway Worker (no default baked in — this
# repo has no access to the official client's DEFAULT_GATEWAY_URL constant).
RAG_GATEWAY_URL=
# Shared bearer secret. Lives in AWS SSM Parameter Store at
# /wtc/shared/prod/RAG_API_KEY (see wtc-monorepo's apps/rag-gateway/README.md)
# — pull it from there, don't generate a new one.
RAG_API_KEY=

# ─── AWS Bedrock (civic-archive Job 1 answer synthesis + Job 2 summarization)
# ONE Bedrock credential path for BOTH civic-archive LLM calls (switched from
# a separate direct-Anthropic-API path 2026-09-25 per Miclain — see
# lib/bedrock.ts's top doc comment). Dedicated IAM user, least privilege
# (bedrock:InvokeModel only) — do NOT reuse the DynamoDB ops-ledger user's
# credentials here. LIVE in Vercel as of 2026-09-25.
SPARK901_BEDROCK_AWS_ACCESS_KEY_ID=
SPARK901_BEDROCK_AWS_SECRET_ACCESS_KEY=
# Live value: us-east-1. Falls back to "us-east-1" in code if unset.
SPARK901_BEDROCK_AWS_REGION=
# Live value: us.amazon.nova-lite-v1:0 (Amazon Nova Lite — cheaper than
# Claude on Bedrock, Miclain's explicit choice). Falls back to the same
# value in code if unset. Fallback ARNs already permitted by the IAM policy
# without a policy change: Amazon Nova Pro, Claude Haiku 4.5.
SPARK901_BEDROCK_MODEL_ID=

# ─── S3 (civic-archive Job 2: durable summary JSON + PDF storage) ───────
# Bucket name — UNSET = the sync job generates summaries/PDFs but can't
# persist them (logged, not a crash). Reuses the SPARK901_AWS_ACCESS_KEY_ID /
# SPARK901_AWS_SECRET_ACCESS_KEY / SPARK901_AWS_REGION trio above (the same
# ops-ledger IAM user) — that user's policy needs s3:PutObject added,
# scoped to this bucket's ARN only. See lib/civic-archive-s3.ts.
SPARK901_CIVIC_ARCHIVE_S3_BUCKET=

# ─── DynamoDB rate limit (Ask the Archive: 3 queries / IP / 24h) ────────
# Table name only — reuses the SPARK901_AWS_ACCESS_KEY_ID / SECRET_ACCESS_KEY
# / REGION / IP_HASH_SALT above (the same ops-ledger IAM user, a second
# scoped-down policy attached to it). UNSET = rate limiting is disabled
# (fails open) — Turnstile above is the only remaining guard. Provisioning
# runbook + exact table schema: infra/aws/README.md, "Ask the Archive
# rate-limit table" section. See lib/civic-archive-ratelimit.ts.
SPARK901_ASK_ARCHIVE_RATELIMIT_TABLE=

# ─── Vercel Cron auth (civic-archive Job 2 sync route) ──────────────────
# Deliberately UNPREFIXED — Vercel automatically attaches this exact env
# var as `Authorization: Bearer $CRON_SECRET` on cron-triggered requests.
# See app/api/civic-archive/sync/route.ts's doc comment.
CRON_SECRET=
